import cv2
import mediapipe as mp
import numpy as np

# ---------------- MediaPipe Setup ----------------
mp_hands = mp.solutions.hands
mp_draw = mp.solutions.drawing_utils

hands = mp_hands.Hands(
    max_num_hands=1,
    min_detection_confidence=0.7,
    min_tracking_confidence=0.7
)

# ---------------- Webcam ----------------
cap = cv2.VideoCapture(0)


# ---------------- Fist Detection ----------------
def is_fist(landmarks):
    """
    Returns True if hand is closed (fist)
    """
    tips = [8, 12, 16, 20]  # fingertips

    for tip in tips:
        # if fingertip is above its lower joint → finger open
        if landmarks[tip].y < landmarks[tip - 2].y:
            return False
    return True


# ---------------- Main Loop ----------------
while True:
    ret, frame = cap.read()
    if not ret:
        break

    frame = cv2.flip(frame, 1)
    h, w, _ = frame.shape

    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    result = hands.process(rgb)

    if result.multi_hand_landmarks:
        for hand_landmarks in result.multi_hand_landmarks:

            lm = hand_landmarks.landmark

            # key positions
            wrist_x = int(lm[0].x * w)
            wrist_y = int(lm[0].y * h)

            index_x = int(lm[8].x * w)
            index_y = int(lm[8].y * h)

            pinky_x = int(lm[20].x * w)
            pinky_y = int(lm[20].y * h)

            # -------- Sleep Detection --------
            sleep_mode = is_fist(lm)

            # -------- Draw Puppet --------
            # head
            cv2.circle(frame, (wrist_x, wrist_y - 80), 30, (255, 200, 0), -1)

            # body
            cv2.line(frame, (wrist_x, wrist_y - 50),
                     (wrist_x, wrist_y + 60), (255, 200, 0), 5)

            # arms follow fingers
            cv2.line(frame, (wrist_x, wrist_y),
                     (index_x, index_y), (0, 255, 0), 4)

            cv2.line(frame, (wrist_x, wrist_y),
                     (pinky_x, pinky_y), (0, 255, 0), 4)

            # -------- Face --------
            if sleep_mode:
                cv2.putText(frame, "Zzz",
                            (wrist_x - 20, wrist_y - 90),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.8, (255, 255, 255), 2)
            else:
                # eyes
                cv2.circle(frame, (wrist_x - 10, wrist_y - 90),
                           3, (0, 0, 0), -1)
                cv2.circle(frame, (wrist_x + 10, wrist_y - 90),
                           3, (0, 0, 0), -1)

                # smile
                cv2.ellipse(frame,
                            (wrist_x, wrist_y - 70),
                            (12, 6),
                            0, 0, 180,
                            (0, 0, 0), 2)

            # optional: draw hand skeleton (good for demo)
            mp_draw.draw_landmarks(
                frame,
                hand_landmarks,
                mp_hands.HAND_CONNECTIONS
            )

    cv2.imshow("AR Hand Puppet", frame)

    # press ESC to exit
    if cv2.waitKey(1) & 0xFF == 27:
        break

cap.release()
cv2.destroyAllWindows()
